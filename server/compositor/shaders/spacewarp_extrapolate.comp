#version 450

// Server-side runtime ASW. The input is the latest real composed frame; the
// optical-flow field points back to the preceding real frame. Extrapolation
// predicts the next display interval without relying on game metadata.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D historyFrame;
layout(binding = 1) uniform sampler2D motionVectors;
layout(binding = 2) uniform sampler2D depth;
layout(binding = 3, rgba16f) uniform writeonly image2D outputFrame;

layout(push_constant) uniform Constants {
    vec2 invSize;
    float synthesisFactor;
    float minDepth;
    float maxDepth;
    float poseReprojection;
    vec2 motionScale;
    vec2 motionOffset;
    vec2 transformAlignmentPadding;
    mat4 historyTransform;
    vec4 targetToTangent;
} constants;

vec2 reprojectToHistory(vec2 targetUv, out bool valid)
{
    vec4 values = vec4(targetUv, -1.0, 1.0);
    values.xy = fma(values.xy, constants.targetToTangent.zw, constants.targetToTangent.xy);
    values.y = -values.y;
    values = constants.historyTransform * values;
    valid = values.w > 0.00001;
    if (!valid) {
        return vec2(-1.0);
    }
    return values.xy / values.w * 0.5 + 0.5;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputFrame);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) * constants.invSize;
    vec4 motionSample = texture(motionVectors, uv);
    vec2 unclampedSourceUv;
    bool validReprojection = true;
    bool poseReprojection = constants.poseReprojection > 0.5;
    if (poseReprojection) {
        // The matrix removes the known rotational head motion. Optical flow is
        // now only a residual correction, and low-confidence matches decay to
        // rotation-only reprojection instead of producing a duplicate object.
        vec2 poseSourceUv = reprojectToHistory(uv, validReprojection);
        float confidence = smoothstep(0.35, 0.75, motionSample.b);
        unclampedSourceUv = poseSourceUv + motionSample.rg * constants.synthesisFactor * confidence;
    } else {
        vec2 motion = motionSample.rg * constants.motionScale + constants.motionOffset;
        unclampedSourceUv = uv - motion * constants.synthesisFactor;
    }
    bool insideSource = validReprojection &&
                        all(greaterThanEqual(unclampedSourceUv, vec2(0.0))) &&
                        all(lessThanEqual(unclampedSourceUv, vec2(1.0)));
    vec2 sourceUv = clamp(unclampedSourceUv, vec2(0.0), vec2(1.0));

    // Invalid depth is treated conservatively: do not extrapolate an
    // unbounded value into the output. The color-only path has no real depth;
    // it relies on the pose reprojection and confidence-gated residual flow.
    bool validDepth = true;
    if (!poseReprojection) {
        float sourceDepth = texture(depth, sourceUv).r;
        validDepth = !isnan(sourceDepth) && !isinf(sourceDepth) &&
                     sourceDepth >= constants.minDepth &&
                     sourceDepth <= constants.maxDepth;
    }
    // Low confidence, a scene cut, or an out-of-view prediction falls back to
    // the latest real frame. The headset compositor can still apply ATW to
    // this conservative repeat; it is preferable to a torn synthetic image.
    vec4 color = insideSource && validDepth ? texture(historyFrame, sourceUv)
                                           : texture(historyFrame, uv);
    imageStore(outputFrame, pixel, color);
}
