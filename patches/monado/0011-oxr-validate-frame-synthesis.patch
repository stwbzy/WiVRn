@@ -36,6 +36,8 @@
 
 #include <stdio.h>
 #include <stdlib.h>
+#include <math.h>
+#include <inttypes.h>
 #include <assert.h>
 
 
@@ -579,6 +581,153 @@ verify_depth_layer(struct xrt_compositor *xc,
 }
 #endif // OXR_HAVE_KHR_composition_layer_depth
 
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+static XrResult
+verify_frame_synthesis_sub_image(struct oxr_logger *log,
+                                 uint32_t layer_index,
+                                 uint32_t view_index,
+                                 const char *extension_name,
+                                 const char *field_name,
+                                 const XrSwapchainSubImage *sub_image)
+{
+	if (sub_image->swapchain == XR_NULL_HANDLE) {
+		return oxr_error(log, XR_ERROR_HANDLE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.swapchain) is XR_NULL_HANDLE",
+		                 layer_index, view_index, extension_name, field_name);
+	}
+
+	struct oxr_swapchain *sc = XRT_CAST_OXR_HANDLE_TO_PTR(struct oxr_swapchain *, sub_image->swapchain);
+	if (!sc->released.yes) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.swapchain) swapchain has not been released",
+		                 layer_index, view_index, extension_name, field_name);
+	}
+
+	if (sc->released.index >= (int)sc->swapchain->image_count) {
+		return oxr_error(log, XR_ERROR_RUNTIME_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.swapchain) internal image index out of bounds",
+		                 layer_index, view_index, extension_name, field_name);
+	}
+
+	if (sc->array_layer_count <= sub_image->imageArrayIndex) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.imageArrayIndex == %u) invalid swapchain array index (%u)",
+		                 layer_index, view_index, extension_name, field_name, sub_image->imageArrayIndex,
+		                 sc->array_layer_count);
+	}
+
+	if (sc->face_count != 1) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.swapchain) invalid swapchain face count (expected 1, got %u)",
+		                 layer_index, view_index, extension_name, field_name, sc->face_count);
+	}
+
+	if (is_rect_neg(&sub_image->imageRect)) {
+		return oxr_error(log, XR_ERROR_SWAPCHAIN_RECT_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.imageRect.offset) has negative component(s)",
+		                 layer_index, view_index, extension_name, field_name);
+	}
+
+	if (is_rect_out_of_bounds(&sub_image->imageRect, sc)) {
+		return oxr_error(log, XR_ERROR_SWAPCHAIN_RECT_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.%s.imageRect) is out of image bounds (%u, %u)",
+		                 layer_index, view_index, extension_name, field_name, sc->width, sc->height);
+	}
+
+	return XR_SUCCESS;
+}
+
+static XrResult
+verify_frame_synthesis_info(struct oxr_logger *log,
+                            uint32_t layer_index,
+                            uint32_t view_index,
+                            const char *extension_name,
+                            uint64_t layer_flags,
+                            uint64_t valid_flags,
+                            const XrSwapchainSubImage *motion_vector_sub_image,
+                            const XrPosef *app_space_delta_pose,
+                            const XrSwapchainSubImage *depth_sub_image,
+                            float min_depth,
+                            float max_depth,
+                            float near_z,
+                            float far_z,
+                            const XrVector4f *motion_vector_scale,
+                            const XrVector4f *motion_vector_offset)
+{
+	XrResult ret = verify_frame_synthesis_sub_image(log, layer_index, view_index, extension_name,
+	                                                "motionVectorSubImage", motion_vector_sub_image);
+	if (ret != XR_SUCCESS) {
+		return ret;
+	}
+
+	ret = verify_frame_synthesis_sub_image(log, layer_index, view_index, extension_name, "depthSubImage",
+	                                       depth_sub_image);
+	if (ret != XR_SUCCESS) {
+		return ret;
+	}
+
+	if (!math_quat_validate_within_1_percent((struct xrt_quat *)&app_space_delta_pose->orientation)) {
+		return oxr_error(log, XR_ERROR_POSE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.appSpaceDeltaPose.orientation) is not a valid quat",
+		                 layer_index, view_index, extension_name);
+	}
+
+	if (!math_vec3_validate((struct xrt_vec3 *)&app_space_delta_pose->position)) {
+		return oxr_error(log, XR_ERROR_POSE_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.appSpaceDeltaPose.position) is not valid",
+		                 layer_index, view_index, extension_name);
+	}
+
+	if ((layer_flags & ~valid_flags) != 0) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.layerFlags == 0x%" PRIx64 ") contains unknown bits",
+		                 layer_index, view_index, extension_name, layer_flags);
+	}
+
+	const float values[] = {min_depth, max_depth, near_z, far_z};
+	for (size_t i = 0; i < ARRAY_SIZE(values); i++) {
+		if (!isfinite(values[i])) {
+			return oxr_error(log, XR_ERROR_LAYER_INVALID,
+			                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>) depth parameters must be finite",
+			                 layer_index, view_index, extension_name);
+		}
+	}
+
+	if (min_depth < 0.0f || min_depth > 1.0f || max_depth < 0.0f || max_depth > 1.0f) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>) minDepth and maxDepth must be in [0.0,1.0]",
+		                 layer_index, view_index, extension_name);
+	}
+
+	if (min_depth > max_depth) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.minDepth) %f must be <= maxDepth %f",
+		                 layer_index, view_index, extension_name, min_depth, max_depth);
+	}
+
+	if (near_z == far_z) {
+		return oxr_error(log, XR_ERROR_LAYER_INVALID,
+		                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>.nearZ) must be != farZ",
+		                 layer_index, view_index, extension_name);
+	}
+
+	if (motion_vector_scale != NULL && motion_vector_offset != NULL) {
+		const float vector_values[] = {motion_vector_scale->x, motion_vector_scale->y, motion_vector_scale->z,
+		                              motion_vector_scale->w, motion_vector_offset->x, motion_vector_offset->y,
+		                              motion_vector_offset->z, motion_vector_offset->w};
+		for (size_t i = 0; i < ARRAY_SIZE(vector_values); i++) {
+			if (!isfinite(vector_values[i])) {
+				return oxr_error(log, XR_ERROR_LAYER_INVALID,
+				                 "(frameEndInfo->layers[%u]->views[%u]->next<%s>) motion-vector scale/offset must be finite",
+				                 layer_index, view_index, extension_name);
+			}
+		}
+	}
+
+	return XR_SUCCESS;
+}
+#endif // OXR_HAVE_EXT_frame_synthesis || OXR_HAVE_FB_space_warp
+
 static XrResult
 verify_projection_layer(struct oxr_session *sess,
                         struct xrt_compositor *xc,
@@ -643,6 +792,9 @@ verify_projection_layer(struct oxr_session *sess,
 	// number of depth layers must be 0 or proj->viewCount
 	uint32_t depth_layer_count = 0;
 #endif
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+	uint32_t frame_synthesis_layer_count = 0;
+#endif
 
 	// Check for valid swapchain states.
 	for (uint32_t i = 0; i < proj->viewCount; i++) {
@@ -722,11 +874,78 @@ verify_projection_layer(struct oxr_session *sess,
 			                 view->subImage.imageRect.extent.height, sc->width, sc->height);
 		}
 
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+		const XrFrameSynthesisInfoEXT *frame_synthesis_info = NULL;
+		const XrCompositionLayerSpaceWarpInfoFB *space_warp_info = NULL;
+#ifdef OXR_HAVE_EXT_frame_synthesis
+		frame_synthesis_info = OXR_GET_INPUT_FROM_CHAIN(
+		    view, XR_TYPE_FRAME_SYNTHESIS_INFO_EXT, XrFrameSynthesisInfoEXT);
+#endif
+#ifdef OXR_HAVE_FB_space_warp
+		space_warp_info = OXR_GET_INPUT_FROM_CHAIN(
+		    view, XR_TYPE_COMPOSITION_LAYER_SPACE_WARP_INFO_FB, XrCompositionLayerSpaceWarpInfoFB);
+#endif
+
+		if (frame_synthesis_info != NULL && space_warp_info != NULL) {
+			return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+			                 "(frameEndInfo->layers[%u]->views[%u]) cannot contain both XR_EXT_frame_synthesis and XR_FB_space_warp",
+			                 layer_index, i);
+		}
+
+		if (frame_synthesis_info != NULL) {
+#ifdef OXR_HAVE_EXT_frame_synthesis
+			if (!sess->sys->inst->extensions.EXT_frame_synthesis) {
+				return oxr_error(log, XR_ERROR_FEATURE_UNSUPPORTED,
+				                 "(frameEndInfo->layers[%u]->views[%u]) XR_EXT_frame_synthesis was not enabled",
+				                 layer_index, i);
+			}
+			ret = verify_frame_synthesis_info(
+			    log, layer_index, i, "XrFrameSynthesisInfoEXT", frame_synthesis_info->layerFlags,
+			    XR_FRAME_SYNTHESIS_INFO_USE_2D_MOTION_VECTOR_BIT_EXT |
+			        XR_FRAME_SYNTHESIS_INFO_REQUEST_RELAXED_FRAME_INTERVAL_BIT_EXT,
+			    &frame_synthesis_info->motionVectorSubImage, &frame_synthesis_info->appSpaceDeltaPose,
+			    &frame_synthesis_info->depthSubImage, frame_synthesis_info->minDepth,
+			    frame_synthesis_info->maxDepth, frame_synthesis_info->nearZ, frame_synthesis_info->farZ,
+			    &frame_synthesis_info->motionVectorScale, &frame_synthesis_info->motionVectorOffset);
+			if (ret != XR_SUCCESS) {
+				return ret;
+			}
+			frame_synthesis_layer_count++;
+#endif
+		}
+
+		if (space_warp_info != NULL) {
+#ifdef OXR_HAVE_FB_space_warp
+			if (!sess->sys->inst->extensions.FB_space_warp) {
+				return oxr_error(log, XR_ERROR_FEATURE_UNSUPPORTED,
+				                 "(frameEndInfo->layers[%u]->views[%u]) XR_FB_space_warp was not enabled",
+				                 layer_index, i);
+			}
+			ret = verify_frame_synthesis_info(
+			    log, layer_index, i, "XrCompositionLayerSpaceWarpInfoFB", space_warp_info->layerFlags,
+			    XR_COMPOSITION_LAYER_SPACE_WARP_INFO_FRAME_SKIP_BIT_FB, &space_warp_info->motionVectorSubImage,
+			    &space_warp_info->appSpaceDeltaPose, &space_warp_info->depthSubImage, space_warp_info->minDepth,
+			    space_warp_info->maxDepth, space_warp_info->nearZ, space_warp_info->farZ, NULL, NULL);
+			if (ret != XR_SUCCESS) {
+				return ret;
+			}
+			frame_synthesis_layer_count++;
+#endif
+		}
+#endif // OXR_HAVE_EXT_frame_synthesis || OXR_HAVE_FB_space_warp
+
 #ifdef OXR_HAVE_KHR_composition_layer_depth
 		const XrCompositionLayerDepthInfoKHR *depth_info = OXR_GET_INPUT_FROM_CHAIN(
 		    view, XR_TYPE_COMPOSITION_LAYER_DEPTH_INFO_KHR, XrCompositionLayerDepthInfoKHR);
 
 		if (depth_info) {
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+			if (frame_synthesis_info != NULL || space_warp_info != NULL) {
+				return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+				                 "(frameEndInfo->layers[%u]->views[%u]) cannot combine KHR depth with frame-synthesis metadata",
+				                 layer_index, i);
+			}
+#endif
 			ret = verify_depth_layer(xc, log, layer_index, i, depth_info);
 			if (ret != XR_SUCCESS) {
 				return ret;
@@ -734,6 +953,14 @@ verify_projection_layer(struct oxr_session *sess,
 			depth_layer_count++;
 		}
 #endif // OXR_HAVE_KHR_composition_layer_depth
 	}
+
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+	if (frame_synthesis_layer_count > 0 && frame_synthesis_layer_count != proj->viewCount) {
+		return oxr_error(log, XR_ERROR_VALIDATION_FAILURE,
+		                 "(frameEndInfo->layers[%u]) frame-synthesis metadata must be present for every projection view or none",
+		                 layer_index);
+	}
+#endif
 
 #ifdef OXR_HAVE_KHR_composition_layer_depth
@@ -1303,6 +1530,12 @@ submit_projection_layer(struct oxr_session *sess,
 	struct xrt_pose pose[XRT_MAX_VIEWS] = {0};
 	struct xrt_swapchain *swapchains[XRT_MAX_VIEWS] = {0};
 
+#if defined(OXR_HAVE_EXT_frame_synthesis) || defined(OXR_HAVE_FB_space_warp)
+	bool frame_synthesis_present = false;
+	struct xrt_swapchain *mv_swapchains[XRT_MAX_VIEWS] = {0};
+	struct xrt_swapchain *frame_synthesis_d_swapchains[XRT_MAX_VIEWS] = {0};
+#endif
+
 #ifdef OXR_HAVE_KHR_composition_layer_depth
 	// Number of depth layers must be 0 or proj->viewCount.
 	bool d_scs_valid = true;
@@ -1343,6 +1576,73 @@ submit_projection_layer(struct oxr_session *sess,
 		data.proj.v[i].pose = pose[i];
 		fill_in_sub_image(scs[i], &proj->views[i].subImage, &data.proj.v[i].sub);
 		swapchains[i] = scs[i]->swapchain;
+
