# Included after project() by upstream, without modifying its pinned checkout.
set(WIVRN_LAUNCHER_OVERLAY_DIR "${CMAKE_CURRENT_LIST_DIR}")
option(WIVRN_LAUNCHER_LOCAL_VR_CONTRACT "Include the exact local experimental VR contract" OFF)
include("${WIVRN_LAUNCHER_OVERLAY_DIR}/tuning-overlay.cmake")
enable_testing()

function(wivrn_launcher_overlay)
  if(NOT TARGET mocktail OR NOT TARGET mocktail_vr)
    message(FATAL_ERROR "Pinned upstream launcher targets changed")
  endif()
  # Upstream assumes json.hpp is installed globally for this source file.
  target_link_libraries(mocktail_window PRIVATE nlohmann_json::nlohmann_json)
  # Build the XR backend, but require --vr to activate it. Canary is desktop-only.
  foreach(scope IN ITEMS COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
    get_target_property(definitions mocktail_runtime ${scope})
    list(FILTER definitions EXCLUDE REGEX "^MOCKTAIL_VR_DEFAULT_ENABLED=")
    list(APPEND definitions MOCKTAIL_VR_DEFAULT_ENABLED=0)
    set_property(TARGET mocktail_runtime PROPERTY ${scope} "${definitions}")
  endforeach()
  add_executable(wivrn-launcher-canary "${WIVRN_LAUNCHER_OVERLAY_DIR}/canary.cpp")
  target_link_libraries(wivrn-launcher-canary PRIVATE Mocktail::Update)
  mocktail_apply_compile_options(wivrn-launcher-canary)
  add_executable(wivrn-launcher-import "${WIVRN_LAUNCHER_OVERLAY_DIR}/import.cpp")
  target_link_libraries(wivrn-launcher-import PRIVATE Mocktail::Update)
  mocktail_apply_compile_options(wivrn-launcher-import)

  # Upstream's canary uses an environment allowlist. Explicitly disable VR there.
  file(READ "${CMAKE_SOURCE_DIR}/src/update/readiness_canary.cc" canary_source)
  set(canary_anchor "\"MOCKTAIL_ISOLATED_CANARY=1\",")
  string(FIND "${canary_source}" "${canary_anchor}" canary_position)
  if(canary_position EQUAL -1)
    message(FATAL_ERROR "Pinned upstream canary environment anchor missing")
  endif()
  string(REPLACE "${canary_anchor}" "${canary_anchor}\n                         \"MOCKTAIL_VR_ENABLED=0\","
    canary_source "${canary_source}")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/wivrn-overlay")
  set(canary_generated "${CMAKE_BINARY_DIR}/wivrn-overlay/readiness_canary.cc")
  file(WRITE "${canary_generated}" "${canary_source}")
  get_target_property(update_sources mocktail_update SOURCES)
  list(REMOVE_ITEM update_sources src/update/readiness_canary.cc)
  list(APPEND update_sources "${canary_generated}")
  set_property(TARGET mocktail_update PROPERTY SOURCES "${update_sources}")
  wivrn_tuning_overlay()
  if(NOT WIVRN_LAUNCHER_LOCAL_VR_CONTRACT)
    file(READ "${CMAKE_SOURCE_DIR}/src/vr/roblox_vr_device_bridge.cc" source)
    wivrn_bridge_tuning(source)
    wivrn_generated_source(mocktail_vr src/vr/roblox_vr_device_bridge.cc "${source}")
    return()
  endif()
  set(backend "${WIVRN_LAUNCHER_OVERLAY_DIR}/../backend")
  set(original "${CMAKE_SOURCE_DIR}/src/vr/roblox_vr_device_bridge.cc")
  file(READ "${original}" source)
  set(table_anchor "static constexpr VrBuildContract kContracts[] = {")
  set(install_anchor "Status RobloxVrDeviceBridge::Install(const compat::BuildProfile &profile) {")
  foreach(anchor IN ITEMS "${table_anchor}" "${install_anchor}")
    string(FIND "${source}" "${anchor}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Pinned upstream VR bridge anchor missing")
    endif()
  endforeach()
  string(REPLACE "${table_anchor}"
    "${table_anchor}\n      wivrn::roblox::installed_contract," source "${source}")
  string(REPLACE "${install_anchor}" "${install_anchor}
  if (profile.elf_build_id == wivrn::roblox::installed_contract.build_id) {
    const char* consent = std::getenv(\"WIVRN_ROBLOX_EXPERIMENTAL_BUILD\");
    if (!consent || profile.elf_build_id != consent)
      return FailedPrecondition(\"Local static candidate requires exact experimental Build ID opt-in\");
  }" source "${source}")
  wivrn_bridge_tuning(source)
  set(generated "${CMAKE_BINARY_DIR}/wivrn-overlay/roblox_vr_device_bridge.cc")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/wivrn-overlay")
  file(WRITE "${generated}" "#include \"installed_contract.h\"\n${source}")
  get_target_property(sources mocktail_vr SOURCES)
  list(REMOVE_ITEM sources src/vr/roblox_vr_device_bridge.cc)
  list(APPEND sources "${generated}")
  set_property(TARGET mocktail_vr PROPERTY SOURCES "${sources}")
  target_include_directories(mocktail_vr PRIVATE "${backend}")
endfunction()

cmake_language(DEFER CALL wivrn_launcher_overlay)
